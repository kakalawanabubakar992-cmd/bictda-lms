# Copy this file to ".env" and fill in your own values.
# The .env file is ignored by Git, so your secrets never go to GitHub.

# A long random string used to sign login sessions.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=paste-your-random-secret-key-here

# development (on your laptop) or production (on Render)
FLASK_ENV=development

# Leave this EMPTY on your laptop so the app uses the local SQLite file (bictda_lms.db).
# On Render we will set it to the Neon PostgreSQL connection string (Phase 7).
DATABASE_URL=

# Add DEMO interns and facilitators when the database is empty (true/false).
# Programmes, courses and Facilitator IDs are always added - set this to false for real use.
AUTO_SEED=true

# Show the "Demo accounts" box on the sign-in pages (true/false)
SHOW_DEMO_LOGINS=true
